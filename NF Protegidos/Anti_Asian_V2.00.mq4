input int      TrailingPips      = 15;         // Distancia del Trailing (pips)

input string   StopLoss_Settings = "--- AJUSTES DE STOP LOSS ---";
input int      MinSLPips         = 5;          // Stop Loss mÃ­nimo (pips)
input int      ExternalSLDistancePips = 12;    // V2.14: SL estructural: margen externo al extremo de la caja (pips)
input double   MinRR             = 1.0;        // V2.19: R:R mÃ­nimo exigido. Baja de 1.2 a 1.0 (el diagnostico V2.18 mostro que 1.2 bloqueaba 13/43 confirmaciones).

input string   Management_Settings = "--- GESTION DE OPERACIONES ---";
input bool     UseAutoBreakEven    = true;       // Activar Auto Break-Even
input int      BreakEvenActivation = 15;         // Pips ganancia para activar BE
input int      BreakEvenExtraPips  = 1;          // Pips extra sobre SL para asegurar comisiones
input bool     UsePartialClose     = false;      // Activar Cierre Parcial AutomÃ¡tico
input int      PartialClosePips    = 15;         // Pips ganancia para cerrar parcial
input double   PartialClosePercent = 50.0;       // % del lote original a cerrar (ej. 50%)
input int      MaxTradesPerDay     = 1;          // Solo permitimos 1 entrada buena al dÃ­a en continuaciÃ³n
input bool     CloseAtEndOfDay     = false;      // Cerrar todas las operaciones al final del dÃ­a (23:00)

input string   Mode_Settings     = "--- MODO CONTINUACION (SMC) ---";
input double   MinBreakoutTotalPips = 5.0;     // Min pips TOTALES vela ruptura (0 = Inactivo)
input int      MinBreakoutBodyPips = 2;        // Min pips cuerpo vela ruptura M15
input double   MaxPullbackIntoBoxPercent = 40.0; // V2.22: 40% estricto otra vez (pocas operaciones seguras > trampas de liquidez)
input int      MaxPatternBars      = 8;        // Max velas M15 para que se complete el patrÃ³n

input string   JudasPA_Settings  = "--- FILTRO JUDAS PRICE ACTION (V2.16) ---";
input bool     UseJudasPAFilter  = false;      // V2.16b: PUERTA al inicio (no durante el amago). EXPERIMENTAL: puede reducir entradas. Default OFF.
input double   MinWickRejectionPercent = 30.0; // V2.16: % de mecha mÃ­nimo de la vela de rechazo (30% = mismo que Asian_V2.80)
input double   RejectionCloseBufferPips = 5.0; // V2.16: pips de cierre de vuelta a la caja para confirmar el Judas
input int      JudasLookbackCandles   = 12;    // V2.16: velas M15 hacia atrÃ¡s para buscar el rechazo confirmado

input string   News_Settings     = "--- NEWS FILTER (API) ---";
input bool     UseNewsFilter     = true;       // Activar Filtro de Noticias
input int      MinsBeforeNews    = 30;         // Minutos antes de la noticia para pausar
input int      MinsAfterNews     = 30;         // Minutos después de la noticia para pausar
input bool     FilterHighImpact  = true;       // Filtrar Carpetas Rojas (Alta)
input bool     FilterMedImpact   = false;      // Filtrar Carpetas Naranjas (Media)
input string   Trend_Settings    = "--- FILTRO DE TENDENCIA ---";
input bool     UseTrendFilter    = true;       // Activar Filtro EMA (Modo Auto)
input ENUM_TIMEFRAMES TrendTF    = PERIOD_M15; // V2.21: baja de H1 a M15 para que fluya con la tendencia intradía real
input int      FastEMAPeriod     = 50;         // Periodo EMA Rapida
input int      SlowEMAPeriod     = 200;        // Periodo EMA Lenta

