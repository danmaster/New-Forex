//|                        Fixes: re-deteccion tras Judas + TrailingStop vs UseFixedRR |
//|                        V2.13: DST auto (caja asiatica fija en hora de Tokio) |
//|                        V2.14: SL estructural + TP estructural (medida proyectada) + MinRR |
//|                        V2.15: ventana de entrada limitada a killzone Londres (MaxEntryHour=13) |
//|                        V2.16: filtro Judas PA (vela de rechazo) alineado con Asian_V2.80 |
//|                        V2.17: SL estructural anclado al extremo del amago (no al techo/suelo de caja) |
//|                        V2.18: diagnosticos de descarte (resumen diario ANTI-DIAG en el Journal) |
//|                        V2.19: relajar filtro de tendencia (solo cruce EMA, sin precio>EMA200) + MinRR 1.2->1.0 |
//|                        V2.20: relajar invalidacion de soporte (el amago ya no se mata al tocar el low de ruptura) |
//|                        V2.21: MaxPullbackIntoBoxPercent 40->100 (solo invalida al romper el lado contrario) + TrendTF H1->M15 |
//|                        V2.22: pullback 100->40 (estricto, evitar trampas) + UseTrailingStop=false (TP estructural respira) |
//+------------------------------------------------------------------+
#property copyright "Antigravity AI"
#property link      ""
#property version   "2.22" // MQL4 requiere formato "x.xx" mÃ¡ximo 2 decimales
#property strict

//--- Input parameters
input string   General_Settings  = "--- AJUSTES GENERALES ---";
input bool     UseDynamicLot     = true;       // Activar Lote DinÃ¡mico (1%)
input double   RiskPercent       = 1.0;        // Riesgo por operaciÃ³n (%)
input bool     InpSendPush       = true;       // Enviar NotificaciÃ³n al MÃ³vil
input double   FixedLotSize      = 0.10;       // Lote Fijo (si Auto es false)
input int      MinBoxPips        = 10;         // TamaÃ±o MÃ­nimo Caja (pips)
input int      MaxBoxPips        = 50;         // TamaÃ±o MÃ¡ximo Caja (pips)
input int      MagicNumber       = 200200;     // Magic Number (Distinto para Anti-Breakout)
input int      StartHour         = 3;          // Hora inicio Asia (03:00 Skilling verano - Se ajustara auto por DST). Invierno: 02:00
input int      EndHour           = 9;          // Hora fin Asia (09:00 Skilling verano - Se ajustara auto por DST). Invierno: 08:00
input int      MaxEntryHour      = 13;         // V2.15: Hora mÃ¡xima de entrada (fin killzone Londres). Antes 18 = tarde/NY casi no ganan
input int      RefGMTOffset      = 3;          // V2.13: offset GMT del broker al que estan calibradas las horas de la caja (3 = GMT+3 verano Skilling)

input string   Days_Settings     = "--- FILTRO DE DIAS ---";
input bool     TradeMonday       = true;       // Operar Lunes
input bool     TradeTuesday      = true;       // Operar Martes
input bool     TradeWednesday    = true;       // Operar Miercoles
