//@version=5
strategy("Asian Breakout V1.02 [Antigravity]", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// --- AJUSTES GENERALES ---
riskPercent = input.float(1.0, title="Riesgo por operación (%)", group="Ajustes Generales")
minBoxPips = input.int(10, title="Tamaño Mínimo Caja (pips)", group="Ajustes Generales")
maxBoxPips = input.int(50, title="Tamaño Máximo Caja (pips)", group="Ajustes Generales")
sessionTime = input.session("0200-0800", title="Sesión Asiática", group="Ajustes Generales")
brokerTimezone = input.string("UTC+3", title="Zona Horaria Broker", group="Ajustes Generales", tooltip="Skilling y RoboForex suelen usar UTC+3 (Horario Verano).")

// --- FILTRO DE DÍAS ---
tradeMon = input.bool(false, title="Operar Lunes", group="Filtro de Días")
tradeTue = input.bool(true, title="Operar Martes", group="Filtro de Días")
tradeWed = input.bool(true, title="Operar Miércoles", group="Filtro de Días")
tradeThu = input.bool(true, title="Operar Jueves", group="Filtro de Días")
tradeFri = input.bool(false, title="Operar Viernes", group="Filtro de Días")

// --- OBJETIVOS DE BENEFICIO ---
fixedRR = input.float(3.0, title="Ratio R:R Fijo", group="Objetivos")
useFixedRR = input.bool(true, title="Activar TP Fijo por Ratio", group="Objetivos")

// --- MODO DE LIQUIDEZ ---
// Recomendación: Bajar minBreakoutBodyPips a 1 o 0 si OANDA/FXCM se traga pips vs MT4
minBreakoutBodyPips = input.int(2, title="Min pips cuerpo vela ruptura", group="Liquidez (SMC)")
maxCandlesOutside = input.int(6, title="Max velas fuera de caja", group="Liquidez (SMC)")

// --- FILTRO DE TENDENCIA ---
useTrendFilter = input.bool(true, title="Activar Filtro EMA H1", group="Filtro Tendencia")
fastEmaPeriod = input.int(50, title="EMA Rápida H1", group="Filtro Tendencia")
slowEmaPeriod = input.int(200, title="EMA Lenta H1", group="Filtro Tendencia")

// --- GESTION ---
slBufferPips = input.int(3, title="SL Buffer (pips)", group="Gestión")
minSlPips = input.int(5, title="SL Mínimo (pips)", group="Gestión")
maxTradesPerDay = input.int(2, title="Máx operaciones por día", group="Gestión")

// Funciones de utilidad
pipSize = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)
toPips(points) => points / pipSize
fromPips(pips) => pips * pipSize

// Días permitidos calculados EXACTAMENTE sobre la zona horaria del Broker
brokerDayOfWeek = dayofweek(time, brokerTimezone)
isTradingDay = (brokerDayOfWeek == dayofweek.monday and tradeMon) or 
               (brokerDayOfWeek == dayofweek.tuesday and tradeTue) or 
               (brokerDayOfWeek == dayofweek.wednesday and tradeWed) or 
               (brokerDayOfWeek == dayofweek.thursday and tradeThu) or 
               (brokerDayOfWeek == dayofweek.friday and tradeFri)

// Detectar sesión (Forzando la zona horaria del Broker)
inSession = not na(time(timeframe.period, sessionTime, brokerTimezone))
sessionStart = inSession and not inSession[1]
sessionEnd = not inSession and inSession[1]

// Control de horario de trading
inTradingWindow = not na(time(timeframe.period, "0800-2300", brokerTimezone))

var float asianHigh = na
var float asianLow = na
var bool boxValid = false
var int tradesToday = 0

if sessionStart
    asianHigh := high
    asianLow := low
    boxValid := false
    tradesToday := 0 // Reset diario
else if inSession
    asianHigh := math.max(asianHigh, high)
    asianLow := math.min(asianLow, low)

if sessionEnd
    float boxPips = toPips(asianHigh - asianLow)
    boxValid := boxPips >= minBoxPips and boxPips <= maxBoxPips

// Dibujar caja
var box asianBox = na
if sessionStart
    asianBox := box.new(bar_index, high, bar_index, low, bgcolor=color.new(color.blue, 90), border_color=color.blue)
if inSession and not na(asianBox)
    box.set_top(asianBox, asianHigh)
    box.set_bottom(asianBox, asianLow)
    box.set_right(asianBox, bar_index)

// EMAs H1 (Forma robusta anti-repintado para coincidir con MT4 iClose/iMA shift 1)
get_ema(len) => ta.ema(close, len)
h1Fast = request.security(syminfo.tickerid, "60", get_ema(fastEmaPeriod)[1], barmerge.gaps_off, barmerge.lookahead_on)
h1Slow = request.security(syminfo.tickerid, "60", get_ema(slowEmaPeriod)[1], barmerge.gaps_off, barmerge.lookahead_on)
h1Close = request.security(syminfo.tickerid, "60", close[1], barmerge.gaps_off, barmerge.lookahead_on)

isUptrend = h1Fast > h1Slow and h1Close > h1Slow
isDowntrend = h1Fast < h1Slow and h1Close < h1Slow

if not useTrendFilter
    isUptrend := true
    isDowntrend := true

// Lógica SMC
var bool sweptHigh = false
var bool sweptLow = false
var float peakHigh = na
var float troughLow = na
var int barsSinceSweepHigh = 0
var int barsSinceSweepLow = 0

// Reiniciar lógica al inicio de sesión
if sessionStart
    sweptHigh := false
    sweptLow := false

// Evaluar solo en la ventana de trading válida
canTrade = not inSession and inTradingWindow and boxValid and isTradingDay and strategy.opentrades == 0 and tradesToday < maxTradesPerDay

if canTrade
    float bodyPips = toPips(math.abs(close - open))
    
    // 1. Detectar Ruptura (Sweep)
    if close > asianHigh
        if not sweptHigh and bodyPips >= minBreakoutBodyPips
            sweptHigh := true
            peakHigh := high
            barsSinceSweepHigh := 0
        else if sweptHigh
            peakHigh := math.max(peakHigh, high)
            barsSinceSweepHigh += 1
    else if sweptHigh
        barsSinceSweepHigh += 1
        
    if close < asianLow
        if not sweptLow and bodyPips >= minBreakoutBodyPips
            sweptLow := true
            troughLow := low
            barsSinceSweepLow := 0
        else if sweptLow
            troughLow := math.min(troughLow, low)
            barsSinceSweepLow += 1
    else if sweptLow
        barsSinceSweepLow += 1

    // Caducidad
    if sweptHigh and barsSinceSweepHigh > maxCandlesOutside
        sweptHigh := false
    if sweptLow and barsSinceSweepLow > maxCandlesOutside
        sweptLow := false

    // 2. Reversión
    bool triggerSell = false
    bool triggerBuy = false

    if sweptHigh and close < asianHigh
        if close < open
            triggerSell := true
        else
            sweptHigh := false // Entró a la caja sin fuerza bajista -> Invalida trampa
    
    if sweptLow and close > asianLow
        if close > open
            triggerBuy := true
        else
            sweptLow := false // Entró a la caja sin fuerza alcista -> Invalida trampa

    // Ejecución Estilo Quick Flip Scalper (MARKET ENTRY DIRECTA)
    if triggerSell and isDowntrend
        float slPrice = peakHigh + fromPips(slBufferPips)
        float slDist = toPips(slPrice - close)
        if slDist < minSlPips
            slDist := minSlPips
            slPrice := close + fromPips(slDist)
        
        float tpPrice = useFixedRR ? close - fromPips(slDist * fixedRR) : na
        
        float riskAmount = strategy.equity * (riskPercent / 100)
        float pointValue = syminfo.pointvalue
        float qty = riskAmount / (slDist * pipSize * pointValue)
        
        strategy.entry("Sell SMC", strategy.short, qty=qty)
        strategy.exit("Exit Sell", "Sell SMC", stop=slPrice, limit=tpPrice)
        
        sweptHigh := false // Reset
        tradesToday += 1
        
    if triggerBuy and isUptrend
        float slPrice = troughLow - fromPips(slBufferPips)
        float slDist = toPips(close - slPrice)
        if slDist < minSlPips
            slDist := minSlPips
            slPrice := close - fromPips(slDist)
            
        float tpPrice = useFixedRR ? close + fromPips(slDist * fixedRR) : na
        
        float riskAmount = strategy.equity * (riskPercent / 100)
        float pointValue = syminfo.pointvalue
        float qty = riskAmount / (slDist * pipSize * pointValue)

        strategy.entry("Buy SMC", strategy.long, qty=qty)
        strategy.exit("Exit Buy", "Buy SMC", stop=slPrice, limit=tpPrice)
        
        sweptLow := false // Reset
        tradesToday += 1
